# Copy to .env and fill in. See README for details.

# Local dev: SQLite. Production: Neon/Postgres connection string
# (also switch schema.prisma datasource provider to "postgresql").
DATABASE_URL="file:./dev.db"

# Secret used to sign the admin session JWT (generate: openssl rand -base64 32)
AUTH_SECRET="change-me"

# Public base URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Newsroom"

# Google AdSense publisher id, e.g. ca-pub-1234567890123456 (leave blank to disable)
NEXT_PUBLIC_ADSENSE_CLIENT=""
